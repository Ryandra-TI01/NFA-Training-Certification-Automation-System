{
  "name": "FLOW 1 — Training Auto-Assignment",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const employees = $('Get Employees').all();\n\nconst modules = $('Get Modules').all();\n\nconst assignments = $('Get Assignments').all();\n\nconst newAssignments = [];\n\n// ======================\n// FORMAT DATE HUMAN-READABLE\n// ======================\n\nfunction formatDueDate(isoString) {\n  const date = new Date(isoString);\n  \n  // Tambah 7 jam → WIB\n  const wib = new Date(date.getTime() + (7 * 60 * 60 * 1000));\n  \n  const days   = ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];\n  const months = ['Januari','Februari','Maret','April','Mei','Juni',\n                  'Juli','Agustus','September','Oktober','November','Desember'];\n  \n  const dayName = days[wib.getUTCDay()];\n  const date_   = wib.getUTCDate();\n  const month   = months[wib.getUTCMonth()];\n  const year    = wib.getUTCFullYear();\n  const hours   = String(wib.getUTCHours()).padStart(2, '0');\n  const minutes = String(wib.getUTCMinutes()).padStart(2, '0');\n  \n  return `${dayName}, ${date_} ${month} ${year} pukul ${hours}:${minutes} WIB`;\n}\n\n// ======================\n// GENERATE NEXT ASN ID\n// ======================\n\n// let assignmentCounter = 1;\n\n// if (assignments.length > 0) {\n\n//     // ambil assignment terakhir\n//     const lastAssignment =\n//         assignments[0].json.fields.assignment_id;\n\n//     // contoh:\n//     // ASN004\n\n//     const lastNumber = parseInt(\n//         lastAssignment.replace('ASN', '')\n//     );\n\n//     assignmentCounter = lastNumber + 1;\n// }\n\n\n// ======================\n// MAIN LOOP\n// ======================\n\nfor (const emp of employees) {\n\n    const employee = emp.json.fields;\n\n    // cari module sesuai role employee\n    const employeeModules = modules.filter(mod => {\n\n        const moduleFields = mod.json.fields;\n\n        return (\n            moduleFields[\"role_name (from mandatory_for_role)\"] &&\n            moduleFields[\"role_name (from mandatory_for_role)\"][0] ===\n            employee[\"role_name (from role_id)\"][0]\n        );\n\n    });\n\n\n    // loop module\n    for (const mod of employeeModules) {\n\n        const moduleFields = mod.json.fields;\n\n        // cek duplicate assignment\n        const alreadyAssigned = assignments.some(assign => {\n\n            const assignFields = assign.json.fields;\n\n            return (\n\n                assignFields[\"employee_id (from employee_id)\"] &&\n                assignFields[\"module_name (from module_id)\"] &&\n\n                assignFields[\"employee_id (from employee_id)\"][0] ===\n                employee.employee_id &&\n\n                assignFields[\"module_name (from module_id)\"][0] ===\n                moduleFields.module_id\n\n            );\n\n        });\n\n\n        // kalau belum ada assignment\n        if (!alreadyAssigned) {\n\n            const now = new Date();\n\n            const due = new Date();\n\n            due.setDate(due.getDate() + 14);\n\n            newAssignments.push({\n\n                json: {\n\n                    // assignment_id: 'ASN' +\n                    //     String(assignmentCounter++)\n                    //     .padStart(3, '0'),\n\n                    employee_id: [\n                        emp.json.id\n                    ],\n\n                    module_id: [\n                        mod.json.id\n                    ],\n\n                    employee_name: employee.full_name,\n\n                    employee_email: employee.email,\n\n                    module_name: moduleFields.module_name,\n                    material_link: moduleFields.material_link,\n                    assigned_date: now.toISOString(),\n\n                    due_date: due.toISOString(),\n                    due_date_display: formatDueDate(due),\n                    assigned_date_display: formatDueDate(now),\n\n                    created_at: now.toISOString(),\n\n                    status: 'Assigned',\n\n                    reminder_count: 0\n                }\n\n            });\n\n        }\n\n    }\n\n}\n\nreturn newAssignments;"
      },
