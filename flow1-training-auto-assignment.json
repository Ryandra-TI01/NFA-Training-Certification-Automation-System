    {
      "parameters": {
        "sendTo": "={{ $('Filtering').item.json.employee_email }}",
        "subject": "=Mandatory Training - {{ $('Filtering').item.json.module_name }}",
        "message": "=<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Mandatory Training Assignment</title>\n</head>\n<body style=\"margin: 0; padding: 0; width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; background-color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\">\n\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color: #f8fafc; padding: 40px 16px;\">\n    <tr>\n      <td align=\"center\">\n        \n        <!-- Main Container -->\n        <table width=\"100%\" maxWidth=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width: 600px; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;\">\n          \n          <!-- Header/Branding -->\n          <tr>\n            <td style=\"padding: 40px 40px 24px 40px;\">\n              <div style=\"font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;\">Human Resources &amp; Development</div>\n              <h1 style=\"margin: 0; font-size: 22px; font-weight: 700; color: #0f172a; letter-spacing: -0.01em;\">Mandatory Training Assignment</h1>\n            </td>\n          </tr>\n\n          <!-- Content Body -->\n          <tr>\n            <td style=\"padding: 0 40px 32px 40px; font-size: 15px; line-height: 1.6; color: #334155;\">\n              <p style=\"margin: 0 0 20px 0;\">Halo <strong>{{ $('Filtering').item.json.employee_name }}</strong>,</p>\n              <p style=\"margin: 0 0 32px 0;\">Anda telah ditugaskan untuk menyelesaikan modul pelatihan wajib di bawah ini. Harap pelajari seluruh materi dalam kurun waktu <strong>7 hari ke depan</strong> sebelum mengikuti sesi penilaian/evaluasi resmi.</p>\n\n              <!-- Metadata Grid -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom: 32px; border-top: 1px solid #edf2f7; border-bottom: 1px solid #edf2f7; padding: 16px 0;\">\n                <tr>\n                  <td style=\"padding: 8px 0; vertical-align: top; width: 30%;\">\n                    <span style=\"font-size: 13px; color: #64748b; font-weight: 500;\">Nama Modul</span>\n                  </td>\n                  <td style=\"padding: 8px 0; vertical-align: top; font-weight: 600; color: #0f172a;\">\n                    {{ $('Filtering').item.json.module_name }}\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding: 8px 0; vertical-align: top;\">\n                    <span style=\"font-size: 13px; color: #64748b; font-weight: 500;\">Tanggal Mulai</span>\n                  </td>\n                  <td style=\"padding: 8px 0; vertical-align: top; color: #334155;\">\n                    {{ $('Filtering').item.json.assigned_date_display }}\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding: 8px 0; vertical-align: top;\">\n                    <span style=\"font-size: 13px; color: #64748b; font-weight: 500;\">Status</span>\n                  </td>\n                  <td style=\"padding: 8px 0; vertical-align: top; color: #334155;\">\n                    {{ $('Filtering').item.json.status }}\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Button CTA -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom: 40px;\">\n                <tr>\n                  <td align=\"left\">\n                    <a href=\"{{ $('Filtering').item.json.material_link }}\" style=\"background-color: #0f172a; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 14px; display: inline-block;\">\n                      Akses Materi Pelatihan\n                    </a>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Timeline Section -->\n              <div style=\"border-top: 1px solid #e2e8f0; padding-top: 24px;\">\n                <h2 style=\"margin: 0 0 16px 0; font-size: 14px; font-weight: 600; color: #0f172a; text-transform: uppercase; letter-spacing: 0.05em;\">Timeline &amp; Prosedur</h2>\n                \n                <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size: 14px;\">\n                  <tr>\n                    <td style=\"padding: 6px 0; width: 30%; color: #64748b; vertical-align: top;\">Hari ini</td>\n                    <td style=\"padding: 6px 0; color: #334155; vertical-align: top;\">Modul aktif dan materi dapat diakses.</td>\n                  </tr>\n                  <tr>\n                    <td style=\"padding: 6px 0; color: #64748b; vertical-align: top;\">Hari ke-7</td>\n                    <td style=\"padding: 6px 0; color: #334155; vertical-align: top;\">Tautan evaluasi/quiz akan otomatis dikirimkan ke email Anda.</td>\n                  </tr>\n                  <tr>\n                    <td style=\"padding: 6px 0; color: #941c1c; font-weight: 600; vertical-align: top;\">{{ $('Filtering').item.json.due_date_display }}</td>\n                    <td style=\"padding: 6px 0; color: #941c1c; font-weight: 600; vertical-align: top;\">Batas akhir pengerjaan evaluasi (Sistem ditutup).</td>\n                  </tr>\n                </table>\n              </div>\n\n              <p style=\"margin: 24px 0 0 0; font-size: 13px; color: #64748b;\">\n                Catatan: Evaluasi akhir hanya dapat diambil satu kali. Pastikan Anda telah meninjau kembali seluruh materi yang diberikan sebelum memulai.\n              </p>\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color: #f8fafc; padding: 24px 40px; border-top: 1px solid #e2e8f0;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size: 12px; color: #94a3b8; line-height: 1.5;\">\n                <tr>\n                  <td>\n                    Email ini dikirimkan secara otomatis oleh NFA Training &amp; Certification Platform.<br>\n                    Harap tidak membalas email ini secara langsung. Jika ada kendala teknis, hubungi Helpdesk IT atau Admin HR.\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n        </table>\n        \n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
        "options": {
          "appendAttribution": false
        }
      },
